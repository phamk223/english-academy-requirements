NODE_ENV=development
PORT=3000
POSTGRES_DB=english_academy
POSTGRES_USER=academy
POSTGRES_PASSWORD=replace_with_local_random_password
# Native Node development only; Docker uses the db service hostname.
DATABASE_URL=postgresql://academy:replace_with_local_random_password@localhost:5432/english_academy
# Generate with a cryptographic RNG: 32 bytes encoded as 64 hex characters.
JWT_SECRET=replace_with_random_64_hex_characters
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=604800
