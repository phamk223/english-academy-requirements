// English Academy — simplified MVP proposal
// This is a smaller conceptual model, not a drop-in replacement for database/schema.sql.
// Deferred pending confirmation: multi-role accounts, Teacher-to-class assignments,
// individual lesson assignments, and audit history.
// Assumption: one role per user. Student/Teacher codes are optional user fields.

Project english_academy {
  database_type: 'PostgreSQL'
  Note: 'Simplified MVP proposal. Confirm role and deferred-feature assumptions before converting to production migrations.'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  username text [not null]
  username_normalized text [not null, unique]
  password_hash text [not null]
  display_name text [not null]
  email text
  role text [not null, default: 'STUDENT', note: 'STUDENT | TEACHER | ADMIN; one role per account in this proposal']
  student_code text [unique]
  teacher_code text [unique]
  status text [not null, default: 'ACTIVE', note: 'ACTIVE | LOCKED | INACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table classes {
  id uuid [pk, default: `gen_random_uuid()`]
  class_code text [not null, unique]
  name text [not null]
  status text [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
}

Table class_memberships {
  id uuid [pk, default: `gen_random_uuid()`]
  class_id uuid [not null]
  student_id uuid [not null, note: 'References a users row whose role is STUDENT']
  joined_at date [not null, default: `CURRENT_DATE`]
  left_at date
  indexes {
    (class_id, student_id, joined_at) [unique]
    (student_id, joined_at, left_at)
  }
}

Table learning_weeks {
  id uuid [pk, default: `gen_random_uuid()`]
  calendar_year smallint [not null]
  month_number smallint [not null, note: '1 through 12']
  week_number smallint [not null]
  title text [not null]
  start_date date
  end_date date
  status text [not null, default: 'DRAFT', note: 'DRAFT | ACTIVE | ARCHIVED']
  indexes {
    (calendar_year, month_number, week_number) [unique]
  }
  Note: 'Month and week are represented in one table; monthly views are grouped by calendar_year and month_number.'
}

Table lessons {
  id uuid [pk, default: `gen_random_uuid()`]
  lesson_code text [unique]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
}

Table lesson_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  lesson_id uuid [not null]
  week_id uuid [not null]
  version_number int [not null]
  title text [not null]
  description text
  instructions text
  status text [not null, default: 'DRAFT', note: 'DRAFT | PUBLISHED | ARCHIVED']
  is_current boolean [not null, default: false]
  published_at timestamptz
  published_by uuid
  indexes {
    (lesson_id, version_number) [unique]
    (week_id, status, is_current)
  }
  Note: 'Published versions should be immutable. Enforce at most one current version per lesson in PostgreSQL.'
}

Table lesson_media {
  id uuid [pk, default: `gen_random_uuid()`]
  lesson_version_id uuid [not null]
  media_type text [not null, note: 'AUDIO | VIDEO']
  source_type text [not null, note: 'UPLOAD | EXTERNAL_LINK']
  storage_key text
  external_url text
  duration_seconds int
  sort_order smallint [not null, default: 1]
  indexes {
    (lesson_version_id, sort_order) [unique]
  }
  Note: 'Store binary media in approved object storage, not in the database.'
}

Table questions {
  id uuid [pk, default: `gen_random_uuid()`]
  lesson_version_id uuid [not null]
  question_type text [not null, note: 'MULTIPLE_CHOICE | TRUE_FALSE | CHOOSE_CORRECT_ANSWER | SHORT_ANSWER | MATCHING']
  prompt text [not null]
  points numeric(8,2) [not null, default: 1]
  sort_order smallint [not null]
  indexes {
    (lesson_version_id, sort_order) [unique]
    (id, lesson_version_id) [unique]
  }
}

Table question_options {
  id uuid [pk, default: `gen_random_uuid()`]
  question_id uuid [not null]
  option_key text [not null]
  option_text text [not null]
  sort_order smallint [not null]
  indexes {
    (question_id, option_key) [unique]
    (question_id, sort_order) [unique]
  }
}

Table question_answer_keys {
  question_id uuid [pk]
  answer_key jsonb [not null, note: 'Protected grading data; never return in student API responses']
  updated_at timestamptz [not null, default: `now()`]
}

Table class_lesson_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  class_id uuid [not null]
  lesson_id uuid [not null]
  assigned_by uuid
  assigned_at timestamptz [not null, default: `now()`]
  available_from timestamptz
  available_until timestamptz
  due_at timestamptz
  status text [not null, default: 'ACTIVE', note: 'ACTIVE | CANCELLED | ARCHIVED']
  indexes {
    (class_id, lesson_id, assigned_at) [unique]
    (class_id, status, available_from)
  }
}

Table lesson_attempts {
  id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null]
  lesson_version_id uuid [not null]
  attempt_number int [not null]
  status text [not null, default: 'IN_PROGRESS', note: 'IN_PROGRESS | SUBMITTED | COMPLETED | ABANDONED']
  started_at timestamptz [not null, default: `now()`]
  submitted_at timestamptz
  completed_at timestamptz
  score numeric(10,2)
  indexes {
    (student_id, lesson_version_id, attempt_number) [unique]
    (student_id, started_at)
  }
}

Table lesson_attempt_answers {
  id uuid [pk, default: `gen_random_uuid()`]
  attempt_id uuid [not null]
  question_id uuid [not null]
  answer_data jsonb [not null]
  is_correct boolean
  awarded_points numeric(8,2)
  answered_at timestamptz [not null, default: `now()`]
  indexes {
    (attempt_id, question_id) [unique]
  }
  Note: 'Backend must verify that the question belongs to the lesson version used by the attempt.'
}

Table listening_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null]
  lesson_version_id uuid [not null]
  attempt_id uuid
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  credited_seconds int [not null, default: 0]
}

Table listening_playback_events {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null]
  client_event_id text [not null]
  event_type text [not null, note: 'PLAY | PAUSE | RESUME | SEEK | HEARTBEAT | ENDED | ERROR']
  client_occurred_at timestamptz
  received_at timestamptz [not null, default: `now()`]
  media_position_seconds int
  indexes {
    (session_id, client_event_id) [unique]
    (session_id, received_at)
  }
}

TableGroup accounts [color: #D6EAF8] {
  users
}

TableGroup classes_and_assignments [color: #D5F5E3] {
  classes
  class_memberships
  class_lesson_assignments
}

TableGroup learning_content [color: #FCF3CF] {
  learning_weeks
  lessons
  lesson_versions
  lesson_media
  questions
  question_options
  question_answer_keys
}

TableGroup student_activity [color: #E8DAEF] {
  lesson_attempts
  lesson_attempt_answers
  listening_sessions
  listening_playback_events
}

Ref: class_memberships.class_id > classes.id
Ref: class_memberships.student_id > users.id
Ref: lessons.created_by > users.id
Ref: lesson_versions.lesson_id > lessons.id
Ref: lesson_versions.week_id > learning_weeks.id
Ref: lesson_versions.published_by > users.id
Ref: lesson_media.lesson_version_id > lesson_versions.id
Ref: questions.lesson_version_id > lesson_versions.id
Ref: question_options.question_id > questions.id
Ref: question_answer_keys.question_id - questions.id
Ref: class_lesson_assignments.class_id > classes.id
Ref: class_lesson_assignments.lesson_id > lessons.id
Ref: class_lesson_assignments.assigned_by > users.id
Ref: lesson_attempts.student_id > users.id
Ref: lesson_attempts.lesson_version_id > lesson_versions.id
Ref: lesson_attempt_answers.attempt_id > lesson_attempts.id
Ref: lesson_attempt_answers.question_id > questions.id
Ref: listening_sessions.student_id > users.id
Ref: listening_sessions.lesson_version_id > lesson_versions.id
Ref: listening_sessions.attempt_id >? lesson_attempts.id
Ref: listening_playback_events.session_id > listening_sessions.id
